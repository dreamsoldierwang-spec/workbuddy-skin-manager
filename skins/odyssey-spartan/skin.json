{
  "schemaVersion": "2.0",
  "id": "odyssey-spartan",
  "name": "奥德赛·斯巴达",
  "author": "DreamSoldier",
  "description": "以古希腊战场为氛围的深蓝灰冷色调皮肤，红色羽冠作强调色，背景保持清晰，面板毛玻璃保证可读性。",
  "theme": "dark",
  "colors": {
    "accent": "#B83022",
    "secondary": "#A68B5B",
    "surface": "#0F141C",
    "text": "#E2E8F0",
    "textMuted": "#8BA3C7",
    "inputBg": "rgba(15,20,28,0.32)"
  },
  "layers": {
    "background": {
      "type": "image",
      "image": "images/hero.jpg",
      "opacity": 1.0,
      "blur": 0,
      "scale": 1.0,
      "repeat": "no-repeat",
      "position": "center",
      "size": "cover",
      "overlay": "rgba(0,0,0,0.03)",
      "brightness": 1.0,
      "saturation": 1.0,
      "dimOverlay": {
        "enabled": true,
        "start": "rgba(0,0,0,0.18)",
        "end": "rgba(0,0,0,0.35)",
        "radial": "rgba(0,0,0,0.15)"
      }
    },
    "container": {
      "opacity": 0.46,
      "blur": 28,
      "saturation": 1.25,
      "radius": 16,
      "border": "1px solid rgba(255,255,255,0.10)",
      "shadow": "0 8px 32px rgba(0,0,0,0.25)",
      "sidebar": {
        "opacity": 0.36,
        "blur": 28,
        "radius": 0
      },
      "panel": {
        "opacity": 0.22,
        "blur": 28,
        "radius": 20
      },
      "input": {
        "opacity": 0.28,
        "blur": 24,
        "radius": 24
      },
      "header": {
        "opacity": 0.74,
        "blur": 20,
        "radius": 0
      },
      "popup": {
        "opacity": 0.96,
        "blur": 24,
        "radius": 16
      }
    },
    "component": {
      "text": "#E2E8F0",
      "textMuted": "#8BA3C7",
      "textPlaceholder": "#6B82A8",
      "link": "#C9A45C",
      "border": "rgba(255,255,255,0.08)",
      "divider": "rgba(255,255,255,0.06)",
      "shadow": "0 2px 8px rgba(0,0,0,0.20)",
      "buttonPrimary": {
        "bg": "rgba(184,48,34,0.18)",
        "text": "#E94E3E",
        "hoverBg": "#B83022",
        "hoverText": "#FFFFFF",
        "border": "rgba(184,48,34,0.60)"
      },
      "buttonSecondary": {
        "bg": "rgba(15,20,28,0.24)",
        "text": "#E2E8F0",
        "hoverBg": "rgba(255,255,255,0.12)",
        "hoverText": "#E2E8F0",
        "border": "rgba(255,255,255,0.10)"
      },
      "input": {
        "bg": "rgba(15,20,28,0.32)",
        "text": "#E2E8F0",
        "border": "rgba(255,255,255,0.10)",
        "focusBorder": "#B83022",
        "placeholder": "#6B82A8"
      },
      "scrollbar": {
        "thumb": "#A68B5B",
        "track": "transparent",
        "hover": "#B83022"
      }
    },
    "tokens": {
      "primary": "#B83022",
      "secondary": "#A68B5B",
      "success": "#52c41a",
      "warning": "#faad14",
      "error": "#f5222d",
      "surface": "#0F141C",
      "surfaceSolid": "#0F141C",
      "background": "#0F141C",
      "foreground": "#E2E8F0"
    }
  },
  "files": {
    "css": ["theme.css"],
    "images": {
      "hero": "images/hero.jpg"
    }
  }
}
